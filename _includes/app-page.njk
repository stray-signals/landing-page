<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>straysignals.dev :: {{ app }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="icon" href="/favicon.png">
  <link rel="stylesheet" href="/tools/tools.page.css">
  <script type="module">
    try {
      const t = JSON.parse(sessionStorage.getItem('stray_theme') || 'null');
      if (t && typeof t === 'object') {
        for (const [k, v] of Object.entries(t)) document.documentElement.style.setProperty(k, v);
      }
    } catch (e) { /* no stored theme */ }
  </script>
</head>
<body>
  <header class="tools-header">
    <span><a href="/">straysignals.dev</a> <span class="dim">/ {{ crumb }}</span></span>
    <a href="/" id="back">← back to the desktop</a>
  </header>
  <main class="tools-page-main" id="{{ rootId }}"></main>
  <script type="module">
    import { {{ mount }} } from '{{ module }}';
    document.getElementById('back').addEventListener('click', () => {
      try { sessionStorage.setItem('stray_reopen', '{{ app }}'); } catch (e) { /* ignore */ }
    });
    {{ mount }}(document.getElementById('{{ rootId }}'), { mode: 'page' });
  </script>
</body>
</html>
